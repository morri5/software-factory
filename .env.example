LAB_API_URL=http://127.0.0.1:8000
FACTORY_REPO=morri5/factory-playground
FACTORY_APPROVER=morri5
FACTORY_COMMANDS_DIR=~/.claude-personal/commands
FACTORY_POLL_S=60
FACTORY_SEED_REPOS=morri5/factory-playground
FACTORY_THOUGHTS_DIR=~/GitHub/thoughts
LANGFUSE_HOST=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-factory
LANGFUSE_SECRET_KEY=sk-lf-factory
# Langfuse secrets for compose.yaml, only in .env. The encryption key is required:
# openssl rand -hex 32. The gateway runs once both gateway keys are set: the service key
# from openssl rand -hex 32, the JWT key from openssl ecparam -name prime256v1 -genkey -noout,
# written on one line with a literal \n between the PEM lines.
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_AI_GATEWAY_SERVICE_KEY=
LANGFUSE_AI_GATEWAY_JWT_PRIVATE_KEY=
